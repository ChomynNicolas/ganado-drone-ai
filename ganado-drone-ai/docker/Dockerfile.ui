FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app
COPY ui/requirements.txt /app/requirements-ui.txt
RUN python -m pip install --upgrade pip && python -m pip install -r /app/requirements-ui.txt
COPY ui/app.py /app/app.py

EXPOSE 8501
CMD ["python", "-m", "streamlit", "run", "/app/app.py", "--server.port=8501"]
